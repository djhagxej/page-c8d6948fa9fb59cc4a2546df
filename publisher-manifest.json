px;\n    margin-bottom:44px;\n    background:var(--bg);\n  }\n  .hero-top{\n    display:flex;\n    flex-wrap:wrap;\n    align-items:flex-end;\n    justify-content:space-between;\n    gap:14px;\n    border-bottom:2px solid var(--line);\n    padding-bottom:16px;\n    margin-bottom:18px;\n  }\n  h1{\n    font-size:clamp(30px,5vw,46px);\n    line-height:1.15;\n    margin:0;\n    letter-spacing:-0.01em;\n  }\n  h1 em{\n    font-style:normal;\n    color:var(--orange);\n  }\n  .hero-top p{\n    margin:0;\n    max-width:320px;\n    font-size:14px;\n    color:var(--gray);\n  }\n\n  .dash{\n    display:grid;\n    grid-template-columns:repeat(6,1fr);\n    gap:10px;\n  }\n  .cell{\n    border:2px solid var(--line);\n    padding:12px 12px 14px;\n    background:var(--bg);\n  }\n  .cell .k{\n    font-size:11px;\n    letter-spacing:0.08em;\n    color:var(--gray);\n    text-transform:uppercase;\n    display:block;\n    margin-bottom:6px;\n  }\n  .cell .v{\n    font-size:22px;\n    font-weight:800;\n    line-height:1.2;\n  }\n  .cell .v small{font-size:12px;font-weight:600;color:var(--gray);}\n  .cell .n{\n    font-size:12px;\n    color:var(--gray);\n    margin-top:4px;\n  }\n  .cell.wide{grid-column:span 3;}\n  .cell.mid{grid-column:span 2;}\n  .cell.third{grid-column:span 2;}\n  .cell.hero-accent{\n    background:var(--orange);\n    color:#fff;\n  }\n  .cell.hero-accent .k,\n  .cell.hero-accent .n{color:#ffe3d5;}\n  .cell.hero-accent .v{color:#fff;}\n\n  section.block{\n    margin-bottom:52px;\n    scroll-margin-top:20px;\n  }\n  h2{\n    font-size:22px;\n    margin:0 0 4px;\n    letter-spacing:-0.01em;\n  }\n  .sub{\n    font-size:13px;\n    color:var(--gray);\n    margin:0 0 20px;\n  }\n  h3{\n    font-size:16px;\n    margin:0 0 6px;\n  }\n\n  /* 粗描边直角卡片 */\n  .cards{\n    display:grid;\n    grid-template-columns:repeat(auto-fit,minmax(232px,1fr));\n    gap:14px;\n  }\n  .card{\n    border:2px solid var(--line);\n    padding:16px 16px 18px;\n    background:var(--bg);\n  }\n  .card .num{\n    font-size:11px;\n    font-weight:800;\n    letter-spacing:0.1em;\n    color:var(--orange);\n    display:block;\n    margin-bottom:8px;\n  }\n  .card p{\n    margin:0;\n    font-size:14px;\n    color:#333;\n  }\n\n  /* 步骤 */\n  .steps{\n    display:grid;\n    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));\n    gap:14px;\n    counter-reset:step;\n  }\n  .step{\n    border:2px solid var(--line);\n    padding:18px 16px;\n    counter-increment:step;\n    position:relative;\n  }\n  .step::before{\n    content:\"STEP \" counter(step);\n    display:block;\n    font-size:11px;\n    font-weight:800;\n    letter-spacing:0.1em;\n    color:var(--orange);\n    margin-bottom:10px;\n  }\n  .step p{margin:0;font-size:14px;color:#333;}\n\n  /* 套餐横向对比表格 */\n  .planwrap{\n    border:2px solid var(--line);\n    overflow-x:auto;\n  }\n  table{\n    border-collapse:collapse;\n    width:100%;\n    min-width:640px;\n    font-size:14px;\n  }\n  caption{\n    text-align:left;\n    font-size:12px;\n    color:var(--gray);\n    padding:12px 14px;\n    border-bottom:2px solid var(--line);\n    background:var(--panel);\n  }\n  th,td{\n    border-bottom:1px solid #dcdcdc;\n    border-right:1px solid #dcdcdc;\n    padding:12px 14px;\n    text-align:left;\n    vertical-align:top;\n  }\n  th:last-child,td:last-child{border-right:0;}\n  thead th{\n    background:var(--ink);\n    color:#fff;\n    font-size:13px;\n    letter-spacing:0.04em;\n    border-right:1px solid #3a3a3a;\n    border-bottom:2px solid var(--line);\n  }\n  thead th.hot{background:var(--orange);}\n  tbody th{\n    font-weight:700;\n    background:var(--panel);\n    white-space:nowrap;\n  }\n  .price{\n    font-size:19px;\n    font-weight:800;\n    display:block;\n  }\n  .price small{font-size:12px;font-weight:600;color:var(--gray);}\n  .plan-note{font-size:12px;color:var(--gray);display:block;margin-top:4px;}\n  tr.rec td{background:var(--orange-soft);}\n  .pill{\n    display:inline-block;\n    border:2px solid var(--line);\n    padding:1px 8px;\n    font-size:11px;\n    font-weight:800;\n    letter-spacing:0.06em;\n    margin-bottom:6px;\n  }\n  .pill.hot{background:var(--orange);color:#fff;border-color:var(--orange);}\n\n  /* 客户端 */\n  .client{\n    display:grid;\n    grid-template-columns:repeat(auto-fit,minmax(210px,1fr));\n    gap:14px;\n  }\n  .client .card h3{display:flex;align-items:center;justify-content:space-between;gap:8px;}\n  .client .card h3 span{\n    font-size:11px;\n    font-weight:700;\n    color:var(--gray);\n    letter-spacing:0.06em;\n  }\n\n  /* FAQ 双栏 */\n  .faq-grid{\n    display:grid;\n    grid-template-columns:repeat(2,1fr);\n    gap:14px;\n  }\n  .faq-grid article{\n    border:2px solid var(--line);\n    padding:16px;\n  }\n  .faq-grid h3{\n    font-size:15px;\n    margin:0 0 8px;\n    padding-left:28px;\n    position:relative;\n  }\n  .faq-grid h3::before{\n    content:\"Q\";\n    position:absolute;\n    left:0;\n    top:0;\n    width:20px;\n    height:20px;\n    line-height:20px;\n    text-align:center;\n    font-size:12px;\n    font-weight:800;\n    background:var(--orange);\n    color:#fff;\n  }\n  .faq-grid p{margin:0;font-size:14px;color:#333;padding-left:28px;}\n\n  .note{\n    border:2px dashed var(--line);\n    padding:14px 16px;\n    font-size:13px;\n    color:var(--gray);\n    margin-top:18px;\n  }\n\n  footer{\n    border-top:2px solid var(--line);\n    padding-top:16px;\n    font-size:12px;\n    color:var(--gray);\n    display:flex;\n    flex-wrap:wrap;\n    gap:8px 20px;\n    justify-content:space-between;\n  }\n\n  @media (max-width:880px){\n    .shell{flex-direction:column;padding:0 16px;}\n    nav.side{\n      position:static;\n      flex:none;\n      width:100%;\n      min-height:0;\n      border-right:0;\n      border-bottom:2px solid var(--line);\n      padding:20px 0 16px;\n    }\n    nav.side ol{display:flex;flex-wrap:wrap;gap:0 16px;}\n    nav.side li a{border-bottom:0;padding:6px 0;}\n    nav.side .foot{display:none;}\n    .content{padding:24px 0 60px;}\n    .dash{grid-template-columns:repeat(2,1fr);}\n    .cell.wide,.cell.mid,.cell.third{grid-column:span 2;}\n    .faq-grid{grid-template-columns:1fr;}\n  }\n  @media (max-width:520px){\n    .hero{padding:18px 16px;}\n    .dash{grid-template-columns:1fr;}\n    .cell.wide,.cell.mid,.cell.third{grid-column:span 1;}\n  }\n</style><div class=\"shell\">\n\n  <nav class=\"side\" aria-label=\"页面目录\">\n    <div class=\"brandmark\">By<span>Wave</span></div>\n    <p class=\"tagline\">把套餐、客户端和用法一次讲清楚的说明页。</p>\n    <ol>\n      <li><a href=\"#overview\">先看全局</a></li>\n      <li><a href=\"#start\">上手三步</a></li>\n      <li><a href=\"#plans\">套餐对比</a></li>\n      <li><a href=\"#clients\">客户端</a></li>\n      <li><a href=\"#faq\">常见问题</a></li>\n    </ol>\n    <div class=\"foot\">\n      本页价格与权益以页面下单时显示的为准，如有调整会先行更新在这里。\n    </div>\n  </nav>\n\n  <main class=\"content\">\n\n    <header class=\"hero\" id=\"overview\">\n      <div class=\"hero-top\">\n        <h1>ByWave：先弄清楚，<em>再决定</em></h1>\n        <p>你好，这里是 ByWave 的说明页。别急着下单，花三分钟把下面这几块看明白，之后会省掉很多来回问的麻烦。</p>\n      </div>\n\n      <div class=\"dash\">\n        <div class=\"cell mid\">\n          <span class=\"k\">起步价</span>\n          <span class=\"v\">¥15<small> / 月</small></span>\n          <span class=\"n\">基础版，按月付</span>\n        </div>\n        <div class=\"cell third\">\n          <span class=\"k\">年付</span>\n          <span class=\"v\">¥150<small> 起</small></span>\n          <span class=\"n\">按年付相当于十个月</span>\n        </div>\n        <div class=\"cell third\">\n          <span class=\"k\">档位</span>\n          <span class=\"v\">3 <small>档</small></span>\n          <span class=\"n\">基础 / 旗舰 / 团队</span>\n        </div>\n        <div class=\"cell wide hero-accent\">\n          <span class=\"k\">推荐给谁</span>\n          <span class=\"v\">一个人两台设备</span>\n          <span class=\"n\">先从基础版试起，觉得不够再往上换，随时可以调整。</span>\n        </div>\n        <div class=\"cell wide\">\n          <span class=\"k\">这份说明能帮你什么</span>\n          <span class=\"v\">少走弯路</span>\n          <span class=\"n\">套餐差在哪、设备怎么配、遇到问题先检查什么，都写在下面的章节里。</span>\n        </div>\n      </div>\n    </header>\n\n    <section class=\"block\" id=\"start\">\n      <h2>上手三步，别想复杂</h2>\n      <p class=\"sub\">说实话，刚开始用的时候大家都会有点摸不着方向。按顺序来就行。</p>\n      <div class=\"steps\">\n        <div class=\"step\">\n          <h3>先挑一个套餐</h3>\n          <p>看你一个月大概要用多少、同时开几台设备。拿不准就先选基础版，用一两个月再判断需不需要升级。别一上来就买最贵的。</p>\n        </div>\n        <div class=\"step\">\n          <h3>再装对应客户端</h3>\n          <p>手机、电脑各有各的装法。装完之后按客户端里的提示导入配置，这一步是唯一需要耐心的环节，慢一点没关系。</p>\n        </div>\n        <div class=\"step\">\n          <h3>最后测一次再日常用</h3>\n          <p>先连上试几分钟，看看常用网站能不能正常打开。没问题了就当日常工具用，遇到异常再回来看下面的常见问题。</p>\n        </div>\n      </div>\n      <p class=\"note\">提醒一句：订阅是按套餐计费的，换设备不等于换套餐。如果你有三四台设备，先数清楚台数再决定档位，比自己猜要省事。</p>\n    </section>\n\n    <section class=\"block\" id=\"plans\">\n      <h2>套餐横向对比</h2>\n      <p class=\"sub\">三档并排放在一起看，差别其实很清楚：流量、设备数、线路类型。横向比完，心里就有数了。</p>\n      <div class=\"planwrap\">\n        <table>\n          月付价格与年付价格并列展示；年付按十个月折算，长期使用会划算一些。\n          <thead>\n            <tr>\n              <th>项目</th>\n              <th>基础版</th>\n              <th class=\"hot\">旗舰版 · 多数人的选择</th>\n              <th>团队版</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>月付价格</th>\n              <td><span class=\"price\">¥15<small> / 月</small></span></td>\n              <td><span class=\"price\">¥35<small> / 月</small></span></td>\n              <td><span class=\"price\">¥85<small> / 月</small></span></td>\n            </tr>\n            <tr>\n              <th>年付价格</th>\n              <td>¥150 / 年<span class=\"plan-note\">折合下来每月十几块</span></td>\n              <td>¥350 / 年<span class=\"plan-note\">比按月付省两个月</span></td>\n              <td>¥850 / 年<span class=\"plan-note\">适合长期稳定的团队</span></td>\n            </tr>\n            <tr>\n              <th>流量额度</th>\n              <td>每月 100GB</td>\n              <td>每月 300GB</td>\n              <td>每月 1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td>5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>线路</th>\n              <td>普通线路节点池</td>\n              <td>含 IPLC 专线，游戏场景做加速优化</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>流媒体</th>\n              <td>解锁基础流媒体</td>\n              <td>全节点原生流媒体解锁</td>\n              <td>VIP 节点，企业级使用场景</td>\n            </tr>\n            <tr class=\"rec\">\n              <th>额外权益</th>\n              <td>—</td>\n              <td><span class=\"pill hot\">推荐</span><br>7×24 优先工单支持</td>\n              <td><span class=\"pill\">团队</span><br>支持企业定制路由，配专属客户经理</td>\n            </tr>\n            <tr>\n              <th>适合谁</th>\n              <td>一个人，手机加电脑，用量不大</td>\n              <td>两三个人共用，常看视频或打游戏</td>\n              <td>小团队、工作室，设备多且要稳定</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n      <p class=\"note\">套餐权益以本表列出的内容为限，价格如遇调整会同步更新。表中未写明的服务，请不要假设它包含在内。</p>\n\n      <div class=\"cards\">\n        <div class=\"card\">\n          <span class=\"num\">怎么挑</span>\n          <h3>看设备数，不看心情</h3>\n          <p>先把要同时在线的设备数出来。家用三台以内，基础版就够；超过了再谈升级，别反过来。</p>\n        </div>\n        <div class=\"card\">\n          <span class=\"num\">怎么省</span>\n          <h3>能确定长期用就年付</h3>\n          <p>三个档位的年付都按十个月算。不确定会不会长期用，就先月付，试顺了再补年付也不迟。</p>\n        </div>\n        <div class=\"card\">\n          <span class=\"num\">怎么换</span>\n          <h3>档位可以往上调</h3>\n          <p>用量超了，换更高档位就行。反过来降档也可以，具体以你下单时的页面提示为准。</p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"block\" id=\"clients\">\n      <h2>客户端，装在你常用的设备上</h2>\n      <p class=\"sub\">不同系统装法不太一样，下面按平台分开说。每种都只用一两个动作，不难。</p>\n      <div class=\"client\">\n        <div class=\"card\">\n          <span class=\"num\">01</span>\n          <h3>iOS / iPadOS <span>移动端</span></h3>\n          <p>在 App Store 里搜索对应客户端安装，装好后用你的订阅信息完成配置。具体客户端名称与配置方式，请以你下单后页面给出的说明为准。</p>\n        </div>\n        <div class=\"card\">\n          <span class=\"num\">02</span>\n          <h3>Android <span>移动端</span></h3>\n          <p>通过应用商店或安装包获取客户端，打开后按引导添加订阅。如果商店里搜不到，优先看你下单后页面上列出的获取方式。</p>\n        </div>\n        <div class=\"card\">\n          <span class=\"num\">03</span>\n          <h3>Windows <span>桌面端</span></h3>\n          <p>下载安装包后按提示完成安装，第一次打开需要导入一次配置。之后每次开机启动即可，不用重复设置。</p>\n        </div>\n        <div class=\"card\">\n          <span class=\"num\">04</span>\n          <h3>macOS <span>桌面端</span></h3>\n          <p>安装方式与 Windows 类似，注意首次运行时系统可能会弹出权限提示，允许之后就能正常使用。</p>\n        </div>\n        <div class=\"card\">\n          <span class=\"num\">05</span>\n          <h3>路由器 / 其他设备 <span>进阶</span></h3>\n          <p>需要在路由器上做设置的话，建议先确认设备本身是否支持相关功能。这一步偏技术，动手前先看清楚再操作。</p>\n        </div>\n      </div>\n      <p class=\"note\">同一时间在线的设备数量按套餐限制，超出的设备会连不上。如果你经常在多台设备之间切换，记得把不用的先断开。</p>\n    </section>\n\n    <section class=\"block\" id=\"faq\">\n      <h2>常见问题</h2>\n      <p class=\"sub\">下面这些是问得最多的几个。要是你的问题不在这里，也别客气，直接找支持就好。</p>\n      <div class=\"faq-grid\">\n        <article>\n          <h3>我该从哪一档开始？</h3>\n          <p>先数设备，再看用量。一个人手机加电脑，基础版通常够用；两三台以上经常一起在线，直接看旗舰版会更省心。</p>\n        </article>\n        <article>\n          <h3>月付和年付差多少钱？</h3>\n          <p>基础版 15 元每月、150 元每年；旗舰版 35 元每月、350 元每年；团队版 85 元每月、850 元每年。年付相当于按十个月计费。</p>\n        </article>\n        <article>\n          <h3>可以在几台设备上同时用？</h3>\n          <p>基础版 3 台、旗舰版 5 台、团队版 20 台，指的是同时在线的数量。超出后新设备会连不上，先断开一台再试。</p>\n        </article>\n        <article>\n          <h3>流量用超了会怎么样？</h3>\n          <p>到达套餐额度后，当月剩余时间会受限。等下个计费周期恢复，或者提前换到更高档位，看你更在意哪种。</p>\n        </article>\n        <article>\n          <h3>换了新手机，需要重新买套餐吗？</h3>\n          <p>不需要，套餐跟的是你的账户，不是设备。在新设备上装好客户端、完成配置，把旧设备断开就行。</p>\n        </article>\n        <article>\n          <h3>支持哪些客户端？</h3>\n          <p>页面列出了 iOS、Android、Windows、macOS 以及路由器等常见平台。具体客户端名称和获取方式，以下单后页面给出的说明为准。</p>\n        </article>\n        <article>\n          <h3>团队版和另外两档差在哪？</h3>\n          <p>团队版的差别主要在设备数、流量额度、VIP 专属高带宽节点，以及支持企业定制路由和专属客户经理。设备多的团队会更合适。</p>\n        </article>\n        <article>\n          <h3>遇到问题先检查什么？</h3>\n          <p>先确认套餐有没有到期、在线设备是否超限、客户端是不是最新版本。这三项排完还没解决，再带截图找支持，会快很多。</p>\n        </article>\n      </div>\n      <p class=\"note\">以上回答只覆盖已列明的服务范围。本页面没有提到的能力，请不要默认 ByWave 提供。</p>\n    </section>\n\n    <footer>\n      <span>ByWave · 说明页</span>\n      <span>价格与权益以页面下单时显示为准</span>\n    </footer>\n\n  </main>\n</div>",
